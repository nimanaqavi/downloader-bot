{
  "name": "instagram-telegram-downloader",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram bot that downloads public Instagram media with an owner-only admin panel",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.1",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.22",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild": true
  }
}
